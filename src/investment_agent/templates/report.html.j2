<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report.cadence.value|upper }} Yatırım Araştırma Raporu</title>
  <style>
    body { color: #17202a; font: 16px/1.55 system-ui, sans-serif; margin: 2rem auto; max-width: 1100px; padding: 0 1rem; }
    h1, h2, h3 { color: #123b5d; } table { border-collapse: collapse; display: block; overflow-x: auto; width: 100%; }
    th, td { border: 1px solid #ccd6dd; padding: .45rem; text-align: right; white-space: nowrap; }
    th:first-child, td:first-child { text-align: left; } blockquote { background: #fff3cd; margin: 1rem 0; padding: .5rem 1rem; }
    hr { border: 0; border-top: 2px solid #123b5d; margin-top: 2rem; }
  </style>
</head>
<body>{{ body }}</body>
</html>
